---
import type { Post, BookReview } from '../../lib/interfaces.ts';
import { getPostByPageId } from '../../lib/notion/client';
import { getPostLink, getBookReviewLink } from '../../lib/blog-helpers.ts';
import { BOOKS_PUBLIC } from '../../server-constants.ts';
import '../../styles/notion-color.css';
import arrow from '../../images/icon-arrow-link.svg';

export interface Props {
  pageId: string;
}

const { pageId } = Astro.props;

let post: Post | BookReview | null = null;
let href = '';
if (pageId) {
  const entry = await getPostByPageId(pageId);
  // gallery items have no slug, so they can't be linked to from a Mention
  if (entry && entry.source !== 'gallery') {
    post = entry.post as Post | BookReview;
    if (entry.source === 'bookReview' && BOOKS_PUBLIC) {
      href = getBookReviewLink(post.Slug);
    } else if (entry.source !== 'bookReview') {
      href = getPostLink(post.Slug);
    }
  }
}
---

{
  post ? (
    href ? (
      <a href={href} class="link">
        <span class="icon">
          {post.Icon && post.Icon.Type === 'emoji' ? (
            post.Icon.Emoji
          ) : post.Icon && post.Icon.Type === 'external' ? (
            <img
              src={post.Icon.Url}
              class="notion-icon"
              alt="Post title icon in a page link"
            />
          ) : (
            '📄'
          )}
          <img
            src={arrow.src}
            class="icon-link"
            alt="Arrow icon of a page link"
          />
        </span>
        <span class="text">{post.Title}</span>
      </a>
    ) : (
      <span class="link">
        <span class="text not-found">{post.Title}</span>
      </span>
    )
  ) : (
    <a class="link">
      <span class="icon">
        🚫
        <img
          src={arrow.src}
          class="icon-link"
          alt="Arrow icon of a page link"
        />
      </span>
      <span class="text not-found">Post not found</span>
    </a>
  )
}

<style>
  a.link,
  span.link {
    display: inline-flex;
    font-weight: 600;
    gap: 4px;
  }
  span.icon {
    height: fit-content;
    flex-shrink: 0;
    position: relative;
  }
  span.icon img.notion-icon {
    width: 1.3em;
    height: 1.3rem;
    vertical-align: sub;
    flex-shrink: 0;
    position: relative;
  }
  span.icon img.icon-link {
    display: block;
    position: absolute;
    top: 1em;
    right: 0;
    width: 8px;
    height: 8px;
  }
  span.text {
    color: var(--fg);
    font-weight: 500;
    text-decoration: underline;
  }
  span.text.not-found {
    font-weight: normal;
    text-decoration: none;
  }
</style>
