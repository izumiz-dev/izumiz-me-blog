# 静的アセットのキャッシュ設定（Cloudflare Pages）
# ハッシュ付き・不変のアセットは長期キャッシュ、それ以外は中期間キャッシュ。
# HTML ページにはルールを設けず、Pages のデフォルト（max-age=0）を維持する。

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/notion/*
  Cache-Control: public, max-age=31536000, immutable

/scripts/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/default-og-image.png
  Cache-Control: public, max-age=2592000
